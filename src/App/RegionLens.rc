#include <windows.h>
#include "ProductBuild.h"
#include "resource.h"

IDI_REGIONLENS ICON "../App/assets/RegionLens.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION RL_VERSION_TUPLE
 PRODUCTVERSION RL_VERSION_TUPLE
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "RegionLens Project\0"
            VALUE "FileDescription", "RegionLens live screen magnifier\0"
            VALUE "FileVersion", RL_VERSION_TEXT
            VALUE "InternalName", RL_CHANNEL_TEXT
            VALUE "SourceCommit", RL_COMMIT_TEXT
            VALUE "RuntimeProtocol", "1"
            VALUE "OriginalFilename", RL_APP_FILE
            VALUE "ProductName", "RegionLens\0"
            VALUE "ProductVersion", RL_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
